package components

templ CreatePracticePage() {
	@ContentPageLayout("Set up practice", "") {
		<div>
			<h2 class="pb-4 text-lg font-bold">Set up practice</h2>
			<form
				hx-post="/practice"
				hx-target="#results"
				hx-encoding="multipart/form-data"
			>
				<label for="attendance-list" class="form-label">Select attendance file <span class="text-sm ">(.xlsx)</span></label>
				<input class="btn btn-secondary block mb-4" type="file" name="attendace-list" id="attendace-list" accept=".xlsx"/>
				<button type="submit" class="btn btn-primary">Send </button>
			</form>
			<div id="results"></div>
		</div>
	}
}
