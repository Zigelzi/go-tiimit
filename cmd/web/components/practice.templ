package components

import "github.com/Zigelzi/go-tiimit/cmd/web/view"

templ PracticePage(practice view.Practice) {
	@ContentPageLayout("Practices") {
		<div>
			<div class="mt-4 mb-6">
				<p class="text-lg font-bold leading-5">{ practice.Date.Format("Monday _2 January") }</p>
				<p class="text-sand-800 text-sm">{ practice.TotalPlayers() } players in</p>
			</div>
			@Team(practice.Teams[0])
			@Team(practice.Teams[1])
		</div>
	}
}
