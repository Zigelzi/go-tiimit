package components

import "github.com/Zigelzi/go-tiimit/cmd/web/view"

templ PlayersPage(players []view.Player) {
	@Base("Players") {
		<h2 class="text-2xl mb-4">Players</h2>
		<div class="mt-4 mb-8">
			<button
				class="p-2 bg-blue-400 rounded-md inline-block hover:bg-blue-300"
				hx-get="/players/add"
				hx-swap="outerHTML"
			>Add new player to club</button>
		</div>
		if len(players) == 0 {
			<p>Your club doesn't have players yet!</p>
			<p>Add your first player</p>
		} else {
			<div class="w-full overflow-scroll">
				<table class="table-fixed p-2">
					<thead>
						<tr class="text-left text-nowrap">
							<th>ID</th>
							<th>MyClub ID</th>
							<th>Name</th>
							<th>Goalie</th>
							<th>Run power</th>
							<th>Ball handling</th>
							<th>Total score</th>
							<th class="min-w-48">Actions</th>
						</tr>
					</thead>
					for _, player := range players {
						@PlayerRow(player)
					}
				</table>
			</div>
		}
	}
}
