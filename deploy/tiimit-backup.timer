# Starts tiimit-backup.service every Monday at 04:00 Helsinki time. Install
# next to the service, then `sudo systemctl enable --now tiimit-backup.timer`.

[Unit]
Description=Weekly Tiumo database backup

[Timer]
OnCalendar=Mon *-*-* 04:00:00 Europe/Helsinki
# The Pi has no battery clock and may be off at 04:00: a missed run happens
# at the next boot instead of being skipped.
Persistent=true

[Install]
WantedBy=timers.target
