# Tiumo's settings on the Pi. Copy to /etc/tiimit/tiimit.env, owned by root
# and readable by root only (chmod 600); the systemd unit reads it with
# EnvironmentFile=. Do not quote values.

DB_PATH=/var/lib/tiimit/tiimit.db

# This computer only. nginx is the only way in from outside; never use an
# address that listens on all interfaces, such as :8080.
LISTEN_ADDRESS=127.0.0.1:8080

# development or production. Anything else stops the app at startup.
ENV=production

# Optional. Leave it out to run without analytics.
POSTHOG_API_KEY=

# Only for an empty database, to create the first user; remove both once
# that user exists. See docs/deployment-guide.md.
# FIRST_USER_USERNAME=
# FIRST_USER_PASSWORD=
