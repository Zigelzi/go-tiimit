DB_PATH="./PATH_TO_DB/example.db"

GOOSE_MIGRATION_DIR=./sql/schema
GOOSE_DRIVER=sqlite3
GOOSE_DBSTRING=$DB_PATH

POSTHOG_API_KEY=this-is-api-key

# The first user of an empty database. Read on startup only while the database
# has no users; ignored otherwise. Set both or neither, then remove them after
# the first login. See docs/deployment-guide.md.
# Wrap the password in single quotes: without them, or in double quotes, a $
# or a " #" in it changes the password before Tiimit reads it.
# FIRST_USER_USERNAME=
# FIRST_USER_PASSWORD=
